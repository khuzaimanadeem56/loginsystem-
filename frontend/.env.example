# Frontend API Base URL
# For local development with standalone backend:
VITE_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# For production deployment:
# If backend is on a separate service (e.g. Render/Railway):
# VITE_API_URL=https://your-backend.onrender.com
# If backend is routed through same domain via Vercel rewrites:
# VITE_API_URL=/api

